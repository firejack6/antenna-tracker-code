# Local secrets / site defaults — gitignored. Generated by setup_env.py.
# Re-run: python setup_env.py   or   python setup_env.py --apply

# ESP hotspot / STA (applied to src/network_config.h — re-flash after changes)
WIFI_SSID=antenna-tracker
WIFI_PASSWORD=changeme123
WIFI_ACCESS_POINT=true

# OpenSky Network OAuth (applied to dashboard/opensky_credentials.json)
OPENSKY_CLIENT_ID=your-opensky-client-id
OPENSKY_CLIENT_SECRET=

# Tracker site / home (applied to dashboard/testdata/sites.json when lat/lon set)
SITE_ID=home
SITE_LABEL=home
SITE_LAT=
SITE_LON=
SITE_ALT=0

# Local dump1090/readsb (applied to dashboard/local_defaults.json)
ADSB_HOST=127.0.0.1
ADSB_PORT=8080
ADSB_POLL_INTERVAL=0.5

# Dashboard ↔ board TCP (scripts / local_defaults.json)
ESP_TCP=192.168.20.1:9000
